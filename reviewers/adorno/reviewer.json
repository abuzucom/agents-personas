{
  "persona": "adorno",
  "function": "ui",
  "modes": {
    "ui": {
      "prompt": "bundles/ui-full.md",
      "review": true,
      "default": true,
      "json_mode": "PR",
      "require_coverage": true,
      "finding_rules": {
        "keys": ["severity", "class", "file", "line", "title"],
        "severities": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
        "class_prefix": "2."
      }
    },
    "file": {
      "prompt": "bundles/ui-full.md",
      "local": true,
      "json_mode": "File",
      "verdict_line": "RISK",
      "verdicts": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "NONE-FOUND"]
    },
    "piece": {
      "prompt": "bundles/ui-full.md",
      "local": true,
      "json_mode": "Piece",
      "verdict_line": "RISK (partial)",
      "verdicts": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "NONE-FOUND", "NEEDS-HUMAN"]
    },
    "wholesale": {
      "prompt": "bundles/ui-full.md",
      "local": true,
      "json_mode": "Wholesale",
      "verdict_line": "RISK",
      "verdicts": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "NONE-FOUND"]
    },
    "design-spec": {
      "prompt": "bundles/ui-full.md",
      "local": true,
      "json_mode": "Design-spec",
      "verdict_line": "CONFORMANCE",
      "verdicts": ["MATCH", "MISMATCH", "NEEDS-HUMAN"]
    }
  }
}
